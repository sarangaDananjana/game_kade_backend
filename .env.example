# Keep the existing database. Use a new private signing key for this security
# upgrade; the old hard-coded key must be retired (existing users log in again).
DATABASE_URL=postgis://meal_drop:change-me@localhost:5432/meal_drop
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=mealdrop.shop,www.mealdrop.shop,47.236.50.0
CSRF_TRUSTED_ORIGINS=https://mealdrop.shop,https://www.mealdrop.shop
TEXT_LK_API_KEY=
GOOGLE_MAPS_API_KEY=

# Docker's private Redis service. For development, set DEBUG=True,
# SECURE_SSL_REDIRECT=False, and an empty Redis URL. Production requires Redis.
RATE_LIMIT_REDIS_URL=redis://rate_limit_cache:6379/0
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.30.0.1/32
MEALDROP_NETWORK_SUBNET=172.30.0.0/24
MEALDROP_NETWORK_GATEWAY=172.30.0.1
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=86400
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_REQUEST_BYTES=10485760
MAX_UPLOAD_FILE_BYTES=5242880
OTP_MAX_FAILED_ATTEMPTS=5
# Empty in production. Optional internal test accounts receive random OTPs
# visible only in the protected Django admin; there is no fixed test code.
OTP_SMS_BYPASS_NUMBERS=

# Optional overrides: comma-separated positive count/time budgets. Both apply.
# RATE_LIMIT_IP=240/minute,10000/hour
# RATE_LIMIT_API_USER=120/minute,5000/hour
# RATE_LIMIT_API_WRITE_USER=30/minute
# RATE_LIMIT_OTP_SEND_IP=5/minute,30/hour
# RATE_LIMIT_OTP_SEND_PHONE=1/minute,5/hour
# RATE_LIMIT_OTP_SEND_GLOBAL=30/minute,300/hour
# RATE_LIMIT_OTP_VERIFY_IP=15/minute,100/hour
# RATE_LIMIT_OTP_VERIFY_PHONE=10/minute,30/hour
# RATE_LIMIT_TOKEN_REFRESH_IP=20/minute
# RATE_LIMIT_ADMIN_LOGIN_IP=5/minute,30/hour
# RATE_LIMIT_ADMIN_LOGIN_ACCOUNT=10/hour
# RATE_LIMIT_CHECKOUT=5/minute,50/hour
# RATE_LIMIT_DELIVERY_QUOTE=20/minute
# RATE_LIMIT_ROUTE_OPTIMIZE=3/minute,30/hour

# Optional route storage. Keep the existing URI/database during an upgrade.
# An empty MONGO_DATABASE uses the database in the URI, or MealDrop for a new URI.
MONGO_URI=
MONGO_DATABASE=
MONGO_ROUTE_COLLECTION=multivendor_route_states
