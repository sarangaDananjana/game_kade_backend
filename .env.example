# Keep the database and secret already used by your server.
DATABASE_URL=postgis://meal_drop:change-me@localhost:5432/meal_drop
SECRET_KEY=change-me
DEBUG=False
TEXT_LK_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional route storage. Keep the existing URI/database during an upgrade.
# An empty MONGO_DATABASE uses the database in the URI, or MealDrop for a new URI.
MONGO_URI=
MONGO_DATABASE=
MONGO_ROUTE_COLLECTION=multivendor_route_states
